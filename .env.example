# --- MongoDB ---
MONGO_URI=mongodb://localhost:27017
MONGO_DB=wrc
MONGO_COLLECTION_LANDING=decisions_landing
MONGO_COLLECTION_CURATED=decisions_curated

# --- MinIO / S3 ---
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET_LANDING=landing
S3_BUCKET_CURATED=curated

# --- Scraper ---
SCRAPER_START_URL=https://www.workplacerelations.ie/en/search/
PARTITION_MONTHS=1
DOWNLOAD_DELAY=1.0
CONCURRENT_REQUESTS=4